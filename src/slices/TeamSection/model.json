{
  "id": "team_section",
  "type": "SharedSlice",
  "name": "TeamSection",
  "description": "Seccion del equipo profesional",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Cards de profesionales",
      "primary": {
        "section_id": {
          "type": "Text",
          "config": { "label": "ID de seccion", "placeholder": "equipo" }
        },
        "eyebrow": {
          "type": "Text",
          "config": { "label": "Etiqueta superior", "placeholder": "Nuestro Equipo" }
        },
        "heading": {
          "type": "StructuredText",
          "config": { "label": "Titulo", "placeholder": "Nuestro Equipo", "single": "heading2" }
        }
      },
      "items": {
        "name": {
          "type": "Text",
          "config": { "label": "Nombre", "placeholder": "Nombre completo" }
        },
        "role": {
          "type": "Text",
          "config": { "label": "Rol", "placeholder": "CEO y Fisioterapeuta" }
        },
        "credentials": {
          "type": "Text",
          "config": { "label": "Colegiacion", "placeholder": "Colegiada n2844" }
        },
        "bio": {
          "type": "StructuredText",
          "config": {
            "label": "Biografia",
            "placeholder": "Especialidades...",
            "multi": "paragraph,strong,em,list-item"
          }
        },
        "photo": {
          "type": "Image",
          "config": {
            "label": "Retrato",
            "constraint": {},
            "thumbnails": []
          }
        },
        "photo_video": {
          "type": "Link",
          "config": {
            "label": "Video del retrato (opcional, sustituye a la imagen)",
            "select": "media"
          }
        }
      }
    }
  ]
}
