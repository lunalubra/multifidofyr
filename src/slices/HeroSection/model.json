          }
        },
        "cta_secondary_link": {
          "type": "Link",
          "config": {
            "label": "Enlace del boton secundario"
          }
        },
        "background_image": {
          "type": "Image",
          "config": {
            "label": "Imagen de fondo",
            "constraint": {},
            "thumbnails": []
          }
