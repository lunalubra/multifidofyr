{
  "id": "contact_section",
  "type": "SharedSlice",
  "name": "ContactSection",
  "description": "Seccion de contacto con formulario e informacion",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Formulario de contacto e info",
      "primary": {
        "section_id": {
          "type": "Text",
          "config": { "label": "ID de seccion", "placeholder": "contacto" }
        },
        "heading": {
          "type": "StructuredText",
          "config": { "label": "Titulo", "placeholder": "Contacto", "single": "heading2" }
        },
        "booking_label": {
          "type": "Text",
          "config": { "label": "Texto del widget de reserva", "placeholder": "Reserve una cita" }
        },
        "doctoralia_widget_url": {
          "type": "Text",
          "config": { "label": "URL del widget Doctoralia", "placeholder": "https://www.doctoralia.es/clinicas/..." }
        },
        "doctoralia_facility": {
          "type": "Text",
          "config": { "label": "Identificador (slug) de Doctoralia", "placeholder": "multifido-fisioterapia-y-readaptacion" }
        },
        "map_embed_url": {
          "type": "Text",
          "config": { "label": "URL de embed de Google Maps", "placeholder": "https://www.google.com/maps/embed?pb=..." }
        },
        "label_address": {
          "type": "Text",
          "config": { "label": "Etiqueta: Direccion", "placeholder": "Direccion" }
        },
        "address": {
          "type": "StructuredText",
          "config": { "label": "Direccion", "placeholder": "Calle Valdemoro 11...", "multi": "paragraph" }
        },
        "label_phone": {
          "type": "Text",
          "config": { "label": "Etiqueta: Telefono", "placeholder": "Telefono" }
        },
        "phone": {
          "type": "Text",
          "config": { "label": "Telefono", "placeholder": "604940941" }
        },
        "label_email": {
          "type": "Text",
          "config": { "label": "Etiqueta: Email", "placeholder": "Email" }
        },
        "email": {
          "type": "Text",
          "config": { "label": "Email", "placeholder": "multifidofyr@gmail.com" }
        },
        "label_hours": {
          "type": "Text",
          "config": { "label": "Etiqueta: Horario", "placeholder": "Horario" }
        },
        "hours_weekday": {
          "type": "Text",
          "config": { "label": "Horario entre semana", "placeholder": "Lunes a Viernes: 10:00-14:00 y 16:00-20:00" }
        },
        "hours_saturday": {
          "type": "Text",
          "config": { "label": "Horario sabados", "placeholder": "Sabados: 09:00-13:00" }
        },
        "doctoralia_link": {
          "type": "Link",
          "config": { "label": "Enlace Doctoralia" }
        },
        "doctoralia_label": {
          "type": "Text",
          "config": { "label": "Texto del boton Doctoralia", "placeholder": "Reservar en Doctoralia" }
        },
        "directions_link": {
          "type": "Link",
          "config": { "label": "Enlace 'Como llegar'" }
        },
        "directions_label": {
          "type": "Text",
          "config": { "label": "Texto del boton 'Como llegar'", "placeholder": "Como llegar" }
        }
